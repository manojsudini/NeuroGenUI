digraph G {
  graph [rankdir=TB, fontname="Inter", nodesep=0.3, ranksep=0.32, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#f4f7f8", color="#3b4a50", fontname="Inter", fontsize=11, margin="0.14,0.07"];
  edge  [color="#55656b", fontname="Inter", fontsize=9, arrowsize=0.7];
  up  [label="1 upload      POST /upload-sketch -> sketches row + PNG file"];
  an  [label="2 analyze_sketch      OpenCV proposals -> OCR -> vision labels -> merge -> rules -> containment tree  =  SketchAnalysis", fillcolor="#e3f4f6", color="#0e7c8f"];
  tr  [label="3 transcribe      Whisper (audio only; time measured in the browser)"];
  in  [label="4 interpret      intent.parse_commands(text) -> Ops   (create op = components, meta, events)", fillcolor="#e3f4f6", color="#0e7c8f"];
  fu  [label="5 fuse      fusion.fuse_with_report(analysis, ops) -> UI IR (sketch = geometry, voice = semantics)", fillcolor="#e3f4f6", color="#0e7c8f"];
  cg  [label="6 codegen      IR -> Vite/React project + single-script preview"];
  va  [label="7 validate      headless browser: visual + functional checks -> ValidationReport"];
  rp  [label="8 repair      only if validation fails and auto_repair is on; up to 3 passes"];
  sv  [label="9 save      Version row (IR, files, preview, analysis, report, repairs, timings) + screenshot PNG"];
  up -> an -> tr -> in -> fu -> cg -> va -> rp -> sv;
  va -> sv [label="passed", constraint=false, style=dashed];
}
