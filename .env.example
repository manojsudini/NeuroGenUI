# NeuroGenUI settings (copy to .env)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
NGUI_PORT=8200
# Optional: force the validation browser (msedge | chromium)
# NGUI_BROWSER=
# Local OCR for sketch text (needs backend/requirements-ocr.txt); set 0 to disable
NGUI_OCR=1
